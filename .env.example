# Client build-time variables (Expo bakes EXPO_PUBLIC_* values into the web build)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Quantum API mounted base URL used by public endpoint calls and metadata fetches.
EXPO_PUBLIC_QUANTUM_API_BASE_URL=https://davidjgrimsley.com/public-facing/api/quantum/v1
# Local example:
# EXPO_PUBLIC_QUANTUM_API_BASE_URL=http://127.0.0.1:8000/v1

# Optional public-facing UI diagnostics toggle.
# EXPO_PUBLIC_PUBLIC_FACING_DEBUG=1

# Server/runtime variables (used by /api/quantum-backend for API-key endpoint calls)
QUANTUM_PROXY_UPSTREAM_BASE_URL=https://davidjgrimsley.com/public-facing/api/quantum/v1
QUANTUM_BACKEND_API_KEY=qapi_REPLACE_WITH_SERVER_KEY

# Optional explicit CORS allow-list for /api/quantum-backend.
# QUANTUM_PROXY_ALLOWED_ORIGINS=https://davidjgrimsley.com,https://www.davidjgrimsley.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# Plesk Git webhook fallback: copy these keys into a server-local .env.plesk
# when post-deploy hooks do not receive Node.js GUI environment variables.
