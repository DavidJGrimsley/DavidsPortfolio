# Local env. Copy to .env for localhost development.
# Staging and production deployments should use .env.test and .env.production.
# Client-visible EXPO_PUBLIC_* values are also served at runtime by server.js.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional: override Supabase browser flow. Defaults to pkce, except .plesk.page staging uses implicit.
# EXPO_PUBLIC_SUPABASE_AUTH_FLOW=pkce
# Public origin used for SSR / sitemap / SEO canonical URLs.
# Browser auth redirects use window.location.origin at runtime.
# Set this per environment:
# - production: https://davidjgrimsley.com
# - local dev: http://localhost:3000
# - staging: use .env.test with https://quizzical-hofstadter.108-175-12-95.plesk.page
# - production: use .env.production with https://davidjgrimsley.com
EXPO_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Quantum API upstream base URL used by public endpoint calls and metadata fetches.
# Use the real upstream service URL, not this portfolio app's
# /public-facing/api/quantum/v1 proxy route on the same host.
EXPO_PUBLIC_QUANTUM_API_BASE_URL=https://YOUR_QUANTUM_API_HOST/v1
# Local example:
# EXPO_PUBLIC_QUANTUM_API_BASE_URL=http://127.0.0.1:8000/v1

# Optional public-facing UI diagnostics toggle.
# EXPO_PUBLIC_PUBLIC_FACING_DEBUG=1

# Optional: enables live simulator/IBM hardware calls in the Quantum animation card.
# EXPO_PUBLIC_QUANTUM_API_KEY=qapi_PUBLIC_DEMO_KEY

# Server/runtime variable
QUANTUM_BACKEND_API_KEY=qapi_REPLACE_WITH_SERVER_KEY

# Optional explicit CORS allow-list for Quantum proxy routes.
# QUANTUM_PROXY_ALLOWED_ORIGINS=https://davidjgrimsley.com,https://www.davidjgrimsley.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081

# iSquared private beta (https://davidjgrimsley.com/iSquared/). Leave ISQUARED_BETA_CODE_PEPPER
# unset to keep the feature off. See docs/isquared-private-beta.md.
# Required: server-only HMAC key for access-code hashing, 32+ random characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every issued code.
# ISQUARED_BETA_CODE_PEPPER=
# Optional admin dashboard at /iSquared/admin/ (generate the hash with: npm run isquared:beta -- hash-password).
# ISQUARED_ADMIN_USERNAME=
# ISQUARED_ADMIN_PASSWORD_HASH=
# Optional: private directory holding web/ (the built prototype) and data/beta.sqlite.
# Default: <app root>/iSquared-beta. Prefer a path outside the app root and document root.
# ISQUARED_BETA_DIR=
# Optional tuning (defaults shown).
# ISQUARED_TRUSTED_PROXY_HOPS=1
# ISQUARED_SESSION_TTL_HOURS=12
# ISQUARED_SESSION_IDLE_MINUTES=240
# ISQUARED_VISIT_GAP_MINUTES=30
# ISQUARED_AGREEMENT_VERSION=
