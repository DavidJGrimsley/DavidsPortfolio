# Portfolio auth + Quantum API integration
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional override. Defaults to local development /v1 endpoint.
EXPO_PUBLIC_QUANTUM_API_BASE_URL=http://127.0.0.1:8000/v1

# Required for protected /v1 runtime calls from the portfolio UI.
EXPO_PUBLIC_QUANTUM_API_KEY=YOUR_LOW_QUOTA_DEMO_KEY
