RewriteEngine On

# Ensure proper content-type for PWA manifest
AddType application/manifest+json .webmanifest

# Existing files and directories can be served directly by Apache/nginx.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Let Passenger/Node handle SSR pages, API routes, runtime config routes, and
# not-found responses. Rewriting these to "/" strips Expo Router SSR content.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [L]
