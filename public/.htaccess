RewriteEngine On

# Handle case-insensitive routes
RewriteCond %{REQUEST_URI} ^/pokemon/?$ [NC]
RewriteRule ^.*$ /Pokemon/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/mobileapps/?$ [NC]
RewriteRule ^.*$ /MobileApps/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/gamedesign/?$ [NC]
RewriteRule ^.*$ /GameDesign/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/webdev/?$ [NC]
RewriteRule ^.*$ /WebDev/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/about/?$ [NC]
RewriteRule ^.*$ /About/ [R=301,L]

RewriteCond %{REQUEST_URI} ^/learn/?$ [NC]
RewriteRule ^.*$ /Learn/ [R=301,L]

# Handle SPA routing - redirect all requests to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Cache static assets
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg)$">
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</FilesMatch>
