{
  "name": "djsportfolio",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "npm run build:web",
    "build:web": "node scripts/export-web.mjs && node scripts/generate-sitemap.mjs",
    "build:web:deploy": "npm run build:web && node scripts/write-build-marker.mjs",
    "serve:prod": "node server.js",
    "serve:prod:fresh": "npm run build:web:deploy && node server.js",
    "serve:prod:env": "node server.js",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "icons:copy": "node scripts/copy-icons.mjs",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "server": "node server.js",
    "server:dev": "nodemon server.js"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "moduleNameMapper": {
      "^@mr\\.dj2u/quantum-api$": "<rootDir>/node_modules/@mr.dj2u/quantum-api/dist/index.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@mr\\.dj2u/quantum-api))"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/cinzel-decorative": "^0.4.1",
    "@expo-google-fonts/emblema-one": "^0.4.1",
    "@expo-google-fonts/londrina-shadow": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-display": "^0.4.2",
    "@expo-google-fonts/noto-sans-mono": "^0.4.2",
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "@expo-google-fonts/noto-serif-display": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/html-elements": "^0.13.8",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@mr.dj2u/quantum-api": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.100.1",
    "bootstrap": "^5.3.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "expo": "^56.0.12",
    "expo-blur": "~56.0.3",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-image": "~56.0.11",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-server": "~56.0.5",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "express": "^5.2.1",
    "lottie-react": "^2.4.1",
    "lottie-react-native": "^7.3.4",
    "morgan": "^1.10.0",
    "react": "19.2.3",
    "react-bootstrap": "^2.10.4",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-radial-gradient": "^1.1.5",
    "react-native-reanimated": "4.3.1",
    "react-native-responsive-fontsize": "^0.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-native-youtube-iframe": "^2.3.0",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.2.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.14",
    "@types/react-test-renderer": "^18.0.7",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.2.1",
    "jest-expo": "~56.0.5",
    "nodemon": "^3.0.1",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
